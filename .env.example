# ── Site ────────────────────────────────────────────────────────────────
# IMPORTANT: set this to your live domain (no trailing slash). It drives canonical URLs,
# the sitemap, Open Graph links and structured data (SEO/GEO).
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Optional: Google Search Console "HTML tag" verification token (the content="…" value).
GOOGLE_SITE_VERIFICATION=

# Optional: extra hostnames allowed to POST to /api/contact (comma separated, no scheme).
# Your Vercel production + preview domains are allowed automatically.
ALLOWED_ORIGINS=

# ── Contact form → Google Sheets ───────────────────────────────────────
# Server-side only. NEVER prefix these with NEXT_PUBLIC_.
# See docs/google-sheets-setup.md for the 5-minute setup.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
